# ============================================================
# KEEP-ALIVE (free hosts that sleep, e.g. Render)
# ============================================================
# Public URL of this deployment. The router pings <url>/health every 10 min.
# Auto-enabled on Render. Set to "off" to disable.
KEEPALIVE_URL=
# KEEPALIVE_INTERVAL_MS=600000

# Playground "Custom endpoint" mode: allow testing a base URL on a private/local
# address (Ollama, LM Studio, a LAN gateway). Leave unset on any shared gateway.
# PLAYGROUND_ALLOW_PRIVATE_HOSTS=1

# Saved custom endpoints (Playground "Save permanently" / Providers -> Custom endpoints).
# Default: kept in data/custom-endpoints.json, which a host with an ephemeral disk
# (free Render) wipes on every redeploy. To keep them, store them (encrypted) in a
# GitHub branch instead. All three must be set together.
# CUSTOM_ENDPOINTS_GITHUB_REPO=owner/name         # falls back to MODEL_CONFIG_GITHUB_REPO when unset
# CUSTOM_ENDPOINTS_GITHUB_TOKEN=github_pat_...     # fine-grained token, Contents: read and write on that repo
# CUSTOM_ENDPOINTS_SECRET=at-least-12-characters   # encrypts the saved API keys; keep it safe
# CUSTOM_ENDPOINTS_GITHUB_BRANCH=main    # default; saves commit straight to it (no PR). On main, every save redeploys
# CUSTOM_ENDPOINTS_GITHUB_PATH=custom-endpoints.enc.json

# Unified Model Configurator (Configure -> Model Configurator).
# Non-secret capability declarations and enabled flags only: no key is ever
# written here, so this store needs no encryption secret. The local mirror is
# used when GitHub is not configured. With persistence on, GitHub is the source
# of truth at startup and a stale write is refused rather than overwriting a
# newer remote document.
MODEL_CONFIG_FILE=data/model-config.json
# MODEL_CONFIG_GITHUB_REPO=owner/name
# MODEL_CONFIG_GITHUB_TOKEN=github_pat_...     # fine-grained token, Contents: read and write on that repo
# MODEL_CONFIG_GITHUB_BRANCH=main
# MODEL_CONFIG_GITHUB_PATH=model-config.json
# MODEL_CONFIG_GITHUB_API=https://api.github.com
# Any MODEL_CONFIG_GITHUB_* value left unset falls back to the matching
# CUSTOM_ENDPOINTS_GITHUB_* value above, so one repository can serve both.

# --- Provider model lists (Providers page -> "Fetch & edit models") -------------
# On the Providers page you can fetch a built-in provider's own model list and
# keep or remove models. That list REPLACES <PROVIDER>_MODELS for that provider
# until you press "Reset to .env list". Only model ids are stored (never keys).
# Without GitHub the list is kept in the local file below, which a free Render
# disk loses on redeploy; with MODEL_CONFIG_GITHUB_* (or CUSTOM_ENDPOINTS_GITHUB_*)
# set, it is also saved to provider-models.json in the same repository/branch.
# PROVIDER_MODELS_FILE=data/provider-models.json
# PROVIDER_MODELS_GITHUB_PATH=provider-models.json
# PROVIDER_MODELS_GITHUB_REPO / _TOKEN / _BRANCH / _API fall back to MODEL_CONFIG_GITHUB_*.
