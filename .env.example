# ============================================================
# ApiRouter - Environment Configuration
# ============================================================


PORT=8788
# Bind address. Default 127.0.0.1 (this machine only). Hosted deployments (Docker,
# Render) must set HOST=0.0.0.0 AND APIROUTER_API_KEYS; the server refuses to
# start on a non-loopback HOST without keys.
# HOST=127.0.0.1
REQUEST_TIMEOUT_MS=120000
# Streaming requests: max wait for the provider to start responding before falling back.
STREAM_CONNECT_TIMEOUT_MS=30000
# Longest a stream may stay silent after it started (ms). 0 disables.
STREAM_IDLE_TIMEOUT_MS=180000


# Optional client authentication. Leave empty for local trusted use.
APIROUTER_API_KEYS=

# ApiRouter system prompt: prepended to every chat request, in front of the
# client's own system prompt (the client's comes later, so it wins a conflict).
# Default: on. Set SYSTEM_PROMPT=off to disable. SYSTEM_PROMPT_FILE=path/to/prompt.txt
# replaces the built-in text. Playground pinned requests never get it.
# SYSTEM_PROMPT=off
# SYSTEM_PROMPT_FILE=



# ============================================================
# 5. RETRY POLICY
# ============================================================

# Kept for compatibility. Every upstream failure now falls back to the next key
# or model regardless of this list.
RETRY_STATUS_CODES=401,402,403,404,408,409,425,429,500,501,502,503,504,520,521,522,523,524,529




# ============================================================
# FALLBACK CHAIN (optional)
# ============================================================
# Routing order is configuration, not environment: it lives in the Fallback
# Chain, which the control panel owns (Configure -> Fallback Chain).
# This only says WHERE that chain is persisted.

FALLBACK_CHAIN_FILE=data/fallback-chain.json
# Models switched off from the control panel (ids only, no credentials).
DISABLED_MODELS_FILE=data/disabled-models.json

# Where the Control Panel's Shutdown/Resume state is saved, so a shutdown
# survives a restart. (On Render without a persistent disk a redeploy wipes it.)
GATEWAY_STATE_FILE=data/gateway-state.json

# Legacy, read ONCE on first start to seed the chain above, then ignored
# forever. TEXT_PRIORITY_MODELS and VISION_PRIORITY_MODELS are folded into the
# single unified Fallback Chain on first start; they are not active routing
# configuration.
MANUAL_SELECTION_FILE=data/manual-selection.json


# ============================================================
# 1. API KEYS - ALL PROVIDERS
# ============================================================

AGENTROUTER_API_KEYS=

GEMINI_API_KEYS=

GROQ_API_KEYS=

HUGGINGFACE_API_KEYS=

MISTRAL_API_KEYS=

OPENROUTER_API_KEYS=

CEREBRAS_API_KEYS=

CLOUDFLARE_API_KEYS=

CLOUDFLARE_ACCOUNT_IDS=


COHERE_API_KEYS=

ZAI_API_KEYS=

VERCEL_API_KEYS=

NVIDIA_API_KEYS=

OPENCODE_API_KEYS=


POLLINATIONS_API_KEYS=



LLM7_API_KEYS=

UNOROUTER_API_KEYS=




